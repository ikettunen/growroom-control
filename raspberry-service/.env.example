# Backend base URL (growroom-backend listens on port 5000)
API_URL=http://your-backend-server:5000
ROOM_ID=1
POLL_INTERVAL=30

# Sensor
TEMP_SENSOR_TYPE=DHT22
TEMP_SENSOR_PIN=4

# Relays (GPIO BCM numbering)
RELAY_LIGHT_PIN=17
RELAY_FAN_IN_PIN=27
RELAY_FAN_OUT_PIN=22
RELAY_PUMP_PIN=23

# Humidity actuator (dehumidifier)
RELAY_HUMIDITY_PIN=24
HUMIDITY_HYSTERESIS=5
